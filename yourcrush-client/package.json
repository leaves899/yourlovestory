{
  "name": "yourcrush-client",
  "version": "0.1.0",
  "description": "yourcrush Electron 客户端",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "dev:raw": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.78.0",
    "@earendil-works/pi-ai": "^0.78.0",
    "@sinclair/typebox": "^0.32.0",
    "dompurify": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@types/dompurify": "^3.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.yourcrush.client",
    "productName": "yourcrush",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "../scripts",
        "to": "scripts"
      }
    ]
  }
}
